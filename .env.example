# =====================================================================
#  Áurea — configuração da instalação
#  Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.
# =====================================================================

# --- Acesso -----------------------------------------------------------
# Senha para entrar na página (mínimo 8 caracteres; use uma forte).
APP_SENHA=

# Segredo entre a página e o bot (mínimo 24 caracteres). Gere com:
#   openssl rand -hex 24
CHAVE_INTERNA=

# --- Quem é você ------------------------------------------------------
# Nomes que contam como "minha parte" (o resto é "a receber"), separados por vírgula.
# O primeiro é o nome usado quando o bot lança algo seu. Ex.: Ana,Eu
NOMES_EU=Eu

# Ano dos meses gravados sem ano ("Agosto" = Agosto deste ano). Defina uma vez e não mude.
ANO_BASE=2026

# --- IA (leitura de faturas e lançamentos pelo WhatsApp) ---------------
# Pelo menos uma das chaves. Sem nenhuma, só as cobranças pelo WhatsApp funcionam.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI (opcional; vira reserva se o Gemini cair): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Motor principal: gemini ou openai
IA_MOTOR=gemini

# --- WhatsApp ---------------------------------------------------------
# Seu número pessoal (com 55 + DDD), autorizado a vincular o grupo de lançamentos
# com !financas. Vários: separe por vírgula. O número do próprio bot sempre pode.
NUMEROS_AUTORIZADOS=
# Link da página, mostrado no WhatsApp depois de cada lançamento (opcional).
URL_PUBLICA=

# --- Rede -------------------------------------------------------------
# Porta da página no servidor.
PORTA=8080
# Interface onde a porta abre. Com HTTPS, use 127.0.0.1 (só o Caddy fala com a página).
APP_BIND=0.0.0.0
# Endereço para o HTTPS automático. Sem domínio, use o sslip.io com o IP do servidor
# (pontos viram traços): financas.203-0-113-10.sslip.io. Ou o seu: financas.seudominio.com.br
DOMINIO=
# Com HTTPS pelo Caddy, use 1 (IP real para a trava de senha, cookie Secure e HSTS).
# Só junto com APP_BIND=127.0.0.1.
PROXY_CONFIAVEL=0
# Com HTTPS, descomente para o Caddy subir junto em todo "docker compose up".
# COMPOSE_PROFILES=https

# Nível de log do bot: info, warn, debug
LOG_LEVEL=info
